build/

# Frontend client source (keep dist/ for CI docker builds)
client/src/
client/Cargo.toml
client/Trunk.toml
client/index.html
client/styles.css

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Docker (keep config files, exclude Dockerfiles)
docker/*.Dockerfile
.dockerignore

# Documentation and memos
memos/
*.md
LICENSE

# Environment and secrets
.env
.env.*
*.pem
*.key

# OS files
.DS_Store
Thumbs.db

# Test artifacts
*.log
coverage/
