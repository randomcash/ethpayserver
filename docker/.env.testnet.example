# ethpayserver testnet environment
# Copy to .env.testnet and fill in your values

# PostgreSQL
POSTGRES_USER=ethpayserver
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ethpayserver_testnet

# Server
SERVER_PORT=3100
RUST_LOG=info
ENABLE_SWAGGER=true

# EVM Monitor — testnet chains
EVMMONITOR_CHAINS=11155111,80002,421614,11155420,84532

# Sepolia (11155111)
EVMMONITOR_CHAIN_11155111_RPC_HTTP=
EVMMONITOR_CHAIN_11155111_RPC_WS=

# Polygon Amoy (80002)
EVMMONITOR_CHAIN_80002_RPC_HTTP=
EVMMONITOR_CHAIN_80002_RPC_WS=

# Arbitrum Sepolia (421614)
EVMMONITOR_CHAIN_421614_RPC_HTTP=
EVMMONITOR_CHAIN_421614_RPC_WS=

# Optimism Sepolia (11155420)
EVMMONITOR_CHAIN_11155420_RPC_HTTP=
EVMMONITOR_CHAIN_11155420_RPC_WS=

# Base Sepolia (84532)
EVMMONITOR_CHAIN_84532_RPC_HTTP=
EVMMONITOR_CHAIN_84532_RPC_WS=
