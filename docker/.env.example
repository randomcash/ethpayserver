# ethpayserver environment variables
# Copy to .env and fill in your values

# =============================================================================
# PostgreSQL (REQUIRED)
# =============================================================================
POSTGRES_USER=ethpayserver
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=ethpayserver

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_PORT=3000
RUST_LOG=info
# Set to "true" only for development
ENABLE_SWAGGER=false

# =============================================================================
# Error Telemetry (optional — Sentry-protocol, self-hosted errex)
# =============================================================================
# Leave SENTRY_DSN unset to disable error reporting entirely (local/dev default).
# When set, the server and evmmonitor binaries forward panics, errors and
# tracing events through a mandatory PII/secret scrubber (evm::telemetry).
# errex lives on the tailnet, so only set this where errex.homeboy.cloud is
# reachable (debianbase / testnet VPS), not for end-user browsers.
# SENTRY_DSN=https://3cea6a76b6d34e5faa493eac665407e0@errex.homeboy.cloud/random.cash
# SENTRY_ENVIRONMENT=testnet
#
# The Leptos/WASM client reports panics and uncaught JS errors to the same
# backend, but it runs in a browser and so is NOT configured here: fill in the
# `errex-dsn` / `errex-environment` meta tags in client/index.html (empty =
# disabled, the default). Same tailnet caveat, harder: only browsers on the
# tailnet can post to errex, so enable it for internal/dev deployments only.

# =============================================================================
# WebAuthn Configuration
# =============================================================================
# Required for passkey authentication on deployed environments.
# Defaults are for local development; override for production/testnet.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8080
WEBAUTHN_RP_NAME=PayServer

# =============================================================================
# CAPTCHA (optional — registration works without it)
# =============================================================================
# Supported providers: turnstile, cloudflare (both use Cloudflare Turnstile)
# CAPTCHA_PROVIDER=turnstile
# CAPTCHA_SECRET_KEY=0x...
# CAPTCHA_SITE_KEY=0x...

# =============================================================================
# Rate Limiting (optional — defaults are sensible for production)
# =============================================================================
# RATE_LIMIT_AUTH=5       # Auth endpoints: req/min per IP
# RATE_LIMIT_WRITE=10     # Write endpoints: req/min per IP
# RATE_LIMIT_READ=60      # Read endpoints: req/min per IP
# RATE_LIMIT_WS=5         # WebSocket: upgrades/min per IP

# =============================================================================
# Chain Configuration (REQUIRED)
# =============================================================================
# Comma-separated list of chain IDs to monitor
EVMMONITOR_CHAINS=1,137,42161

# =============================================================================
# Mainnet RPC URLs
# =============================================================================
# Ethereum Mainnet (chain_id: 1)
EVMMONITOR_CHAIN_1_RPC_HTTP=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
EVMMONITOR_CHAIN_1_RPC_WS=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Polygon (chain_id: 137)
EVMMONITOR_CHAIN_137_RPC_HTTP=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
EVMMONITOR_CHAIN_137_RPC_WS=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Arbitrum (chain_id: 42161)
EVMMONITOR_CHAIN_42161_RPC_HTTP=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
EVMMONITOR_CHAIN_42161_RPC_WS=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optimism (chain_id: 10)
EVMMONITOR_CHAIN_10_RPC_HTTP=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
EVMMONITOR_CHAIN_10_RPC_WS=wss://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Base (chain_id: 8453)
EVMMONITOR_CHAIN_8453_RPC_HTTP=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
EVMMONITOR_CHAIN_8453_RPC_WS=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# BSC (chain_id: 56)
EVMMONITOR_CHAIN_56_RPC_HTTP=https://bsc-dataseed.binance.org
EVMMONITOR_CHAIN_56_RPC_WS=

# Avalanche (chain_id: 43114)
EVMMONITOR_CHAIN_43114_RPC_HTTP=https://api.avax.network/ext/bc/C/rpc
EVMMONITOR_CHAIN_43114_RPC_WS=

# =============================================================================
# Testnet RPC URLs (for development/testing)
# =============================================================================
# Sepolia (chain_id: 11155111)
# EVMMONITOR_CHAINS=11155111
# EVMMONITOR_CHAIN_11155111_RPC_HTTP=https://sepolia.infura.io/v3/YOUR_KEY
# EVMMONITOR_CHAIN_11155111_RPC_WS=wss://sepolia.infura.io/ws/v3/YOUR_KEY

# Hoodi (chain_id: 560048)
EVMMONITOR_CHAINS=560048
EVMMONITOR_CHAIN_560048_RPC_HTTP=https://sepolia.infura.io/v2/YOUR_KEY
EVMMONITOR_CHAIN_560048_RPC_WS=wss://sepolia.infura.io/ws/v2/YOUR_KEY
