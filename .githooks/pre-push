#!/bin/bash
# Pre-push hook: catch issues before they hit CI.
# Runs fmt check, clippy, and unit tests.
#
# Install: git config core.hooksPath .githooks

set -e

CRATES="-p server -p data-service -p evm -p ethpayserver-client"

echo "=== pre-push: checking format ==="
cargo fmt $CRATES -- --check || { echo "Format check failed. Run: cargo fmt"; exit 1; }

echo "=== pre-push: running clippy ==="
cargo clippy $CRATES --all-targets -- -D warnings || { echo "Clippy failed. Fix warnings."; exit 1; }

echo "=== pre-push: running tests ==="
cargo test --workspace --lib --no-fail-fast || { echo "Tests failed."; exit 1; }

echo "All checks passed."
